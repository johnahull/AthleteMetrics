{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/health/liveness",
    "healthcheckTimeout": 90
  },
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    "staging": {
      "variables": {
        "NODE_ENV": "staging",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "ENABLE_DEBUG_LOGGING": "true"
      }
    },
    "testing": {
      "variables": {
        "NODE_ENV": "testing",
        "NODE_OPTIONS": "--max-old-space-size=2048",
        "ENABLE_DEBUG_LOGGING": "true"
      }
    },
    "pr": {
      "deploy": {
        "startCommand": "node -e \"const http = require('http'); const s = http.createServer((q,r)=>{r.writeHead(200,{'Content-Type':'application/json'});r.end(JSON.stringify({status:'alive',timestamp:new Date().toISOString()}))}); s.listen(process.env.PORT||5000,'0.0.0.0',()=>console.log('[diag] listening on '+(process.env.PORT||5000)))\""
      },
      "variables": {
        "NODE_ENV": "testing",
        "NODE_OPTIONS": "--max-old-space-size=2048",
        "ENABLE_DEBUG_LOGGING": "true",
        "IS_PR_ENVIRONMENT": "true"
      }
    }
  }
}
