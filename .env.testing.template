# Testing Environment E2E Configuration
# Copy this file to .env.testing and it will be loaded automatically

# Required: Testing environment URL and credentials
TESTING_URL=https://your-testing-environment.up.railway.app
TESTING_USERNAME=your-testing-username
TESTING_PASSWORD=your-testing-password

# Optional: Database URL for test data setup
# If provided, global-setup will create test organization, users, and teams
# If omitted, tests will use existing data in the testing environment
TESTING_DATABASE_URL=postgresql://user:password@host:port/database

# Optional: RBAC test user credentials
# These are used for permission/role-based access control tests
# If not provided, RBAC tests will be skipped (other tests will still run)
# E2E_SITE_ADMIN_USERNAME=test-site-admin
# E2E_SITE_ADMIN_PASSWORD=your-site-admin-password
# E2E_ORG_ADMIN_USERNAME=test-org-admin
# E2E_ORG_ADMIN_PASSWORD=your-org-admin-password
# E2E_COACH_USERNAME=test-coach
# E2E_COACH_PASSWORD=your-coach-password
# E2E_ATHLETE_USERNAME=test-athlete
# E2E_ATHLETE_PASSWORD=your-athlete-password

# Note: The E2E framework auto-detects which environment to use:
# - If TESTING_URL or TESTING_USERNAME is set → uses Testing environment
# - Otherwise → uses Staging environment
