{
  "name": "@athletemetrics/root",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnahull/AthleteMetrics.git"
  },
  "bugs": {
    "url": "https://github.com/johnahull/AthleteMetrics/issues"
  },
  "homepage": "https://github.com/johnahull/AthleteMetrics#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx packages/api/index.ts",
    "build": "npm run build -w @athletemetrics/web && npm run build -w @athletemetrics/api",
    "prestart": "node scripts/run-migrations.js && node scripts/apply-manual-migrations.js",
    "start": "node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:manual": "node scripts/apply-manual-migrations.js",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:manual",
    "db:migrate:backfill-org": "tsx scripts/migrations/backfill-measurement-organization-id.js",
    "db:validate": "node scripts/validate-migrations.js",
    "test": "NODE_OPTIONS=\"--max-old-space-size=${TEST_HEAP_SIZE:-4096}\" dotenv -e .env.local -- vitest",
    "test:ui": "NODE_OPTIONS=\"--max-old-space-size=${TEST_HEAP_SIZE:-4096}\" dotenv -e .env.local -- vitest --ui",
    "test:run": "NODE_OPTIONS=\"--max-old-space-size=${TEST_HEAP_SIZE:-4096}\" dotenv -e .env.local -- vitest run",
    "test:unit": "NODE_OPTIONS=\"--max-old-space-size=${TEST_HEAP_SIZE:-4096}\" dotenv -e .env.local -- vitest run --config vitest.unit.config.ts",
    "test:integration": "NODE_OPTIONS=\"--max-old-space-size=${TEST_HEAP_SIZE:-4096}\" dotenv -e .env.local -- vitest run --config vitest.integration.config.ts",
    "test:staging": "playwright test --config=playwright.staging.config.ts",
    "test:staging:validate": "playwright test tests/e2e/validate-staging.spec.ts --config=playwright.staging.config.ts",
    "test:testing": "playwright test --config=playwright.testing.config.ts",
    "test:testing:validate": "playwright test tests/e2e/validate-staging.spec.ts --config=playwright.testing.config.ts",
    "test:sendgrid": "tsx scripts/test-sendgrid.ts",
    "deploy:testing": "node scripts/validate-testing-env.js && railway up --environment testing --service athletemetrics-testing",
    "logs:testing": "railway logs --environment testing",
    "shell:testing": "railway run --environment testing bash",
    "vars:testing": "railway variables --environment testing"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.59.1",
    "@replit/vite-plugin-cartographer": "^0.3.2",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.16",
    "@types/passport-apple": "^2.0.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "terser": "^5.44.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^7.1.9",
    "vite-bundle-analyzer": "^1.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "workbox-precaching": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "glob": "^11.1.0",
    "serialize-javascript": "^7.0.3",
    "form-data": "^4.0.6",
    "jest": {
      "minimatch": "^3.1.3"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.92",
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^4.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.2.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "jspdf-autotable": "^5.0.7",
    "mathjs": "^15.1.0",
    "ml-levenberg-marquardt": "^5.0.0",
    "nanoid": "^5.1.11",
    "openai": "^6.38.0",
    "p-limit": "^7.3.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "simple-statistics": "^7.8.9",
    "web-push": "^3.6.7",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  }
}
